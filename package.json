{
  "name": "hikari",
  "productName": "Hikari",
  "version": "1.0.0",
  "description": "Electron shell for Hikari sub-app launcher",
  "main": "src/main/app/start-main-app.js",
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "check:css-colors": "node scripts/check-css-colors.mjs",
    "check:dom-ids": "node scripts/check-dom-ids.mjs",
    "check:source-layout": "node scripts/check-source-layout.mjs",
    "lint": "eslint src scripts eslint.config.mjs",
    "lint:tests": "eslint tests test.js",
    "check:sample-registry-csv": "node tests/sample-registry-csv-io-selfcheck.mjs",
    "check:window-guard": "node tests/window-guard-selfcheck.mjs",
    "check:pdf-export-template": "node tests/pdf-export-template-selfcheck.mjs",
    "check:selfchecks": "fail=0; for f in tests/*-selfcheck.js tests/*-selfcheck.mjs; do node \"$f\" || fail=1; done; exit $fail",
    "extract:standard-features": "node scripts/extract-standard-features.mjs",
    "report:modules": "node scripts/report-module-relationships.mjs",
    "start": "npm run build:ui && electron-forge start",
    "test:checks": "fail=0; for c in lint check:css-colors check:dom-ids check:source-layout check:selfchecks; do npm run \"$c\" || fail=1; done; exit $fail",
    "test:groups": "node test.js --list",
    "test:core": "node test.js '^core/'",
    "test:edge": "node test.js '^edge/'",
    "test:only": "node test.js",
    "test": "npm run build:ui || exit 1; fail=0; npm run test:checks || fail=1; node test.js || fail=1; exit $fail",
    "dist": "npm run build:ui && electron-forge make",
    "package:app": "npm run build:ui && electron-forge package",
    "package": "npm run build:ui && electron-forge package",
    "make": "npm run build:ui && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^40.7.0",
    "eslint": "^9.39.5",
    "onnxruntime-web": "^1.26.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-squirrel-startup": "^1.0.1",
    "zod": "^3.25.0"
  }
}
