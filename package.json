{
  "name": "hikari",
  "productName": "Hikari",
  "version": "1.0.0",
  "description": "Electron shell for Hikari sub-app launcher",
  "main": "src/main/main.js",
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "check:css-colors": "node scripts/check-css-colors.mjs",
    "check:dom-ids": "node scripts/check-dom-ids.mjs",
    "check:source-layout": "node scripts/check-source-layout.mjs",
    "check:sample-registry-csv": "node tests/sample-registry-csv-io-selfcheck.mjs",
    "extract:standard-features": "node scripts/extract-standard-features.mjs",
    "export:agent-context-debug": "node scripts/export-agent-context-debug.mjs",
    "export:agent-prompts": "node scripts/export-agent-prompts.mjs",
    "report:modules": "node scripts/report-module-relationships.mjs",
    "start": "npm run build:ui && electron-forge start",
    "test": "npm run build:ui && npm run check:css-colors && npm run check:dom-ids && npm run check:source-layout && npm run check:sample-registry-csv && node test.js",
    "dist": "npm run build:ui && electron-forge make",
    "package:app": "npm run build:ui && electron-forge package",
    "package": "npm run build:ui && electron-forge package",
    "make": "npm run build:ui && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^40.7.0",
    "onnxruntime-web": "^1.26.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-squirrel-startup": "^1.0.1",
    "telegraf": "^4.16.3",
    "zod": "^3.25.0"
  }
}
