              "name": "volume"
            }
          ]
        },
        {
          "id": "1774024680081-8b59fc78ea4ba",
          "text": "Grow the culture at 37 C with shaking until OD600 reaches {{ph:1774024680081-fab6fafbcf158}}.",
          "placeholders": [
            {
              "id": "1774024680081-fab6fafbcf158",
              "name": "value"
            }
          ]
        },
        {
          "id": "1774024680081-261cf8cde96b5",
          "text": "Add IPTG to a final concentration of {{ph:1774024680081-587c106fae95a}} to induce protein expression.",
          "placeholders": [
            {
              "id": "1774024680081-587c106fae95a",
              "name": "concentration"
            }
          ]
        },
        {
          "id": "1774024680081-060177ce253a3",
          "text": "Shift the culture to {{ph:1774024680081-2ce357c07b8e68}} and continue shaking for {{ph:1774024680081-1e13340d6a10c}}.",
          "placeholders": [
            {
              "id": "1774024680081-2ce357c07b8e68",
              "name": "temperature"
            },
            {
              "id": "1774024680081-1e13340d6a10c",
              "name": "time"
            }
          ]
        },
        {
          "id": "1774024680081-c57e1dcb979b6",
          "text": "Harvest cells by centrifugation at {{ph:1774024680081-d82f101f8190e8}} for {{ph:1774024680081-ad983f4a2f5b68}} at {{ph:1774024680081-4962dce7ed7eb8}}.",
