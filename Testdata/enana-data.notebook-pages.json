        "steps": [
          {
            "id": "1774024680081-30d1ad296ed458",
            "text": "Inoculate {{ph:1774024680081-ff5ea222c2b28}} of expression medium containing {{ph:1774024680081-2608acdba053b}} with {{ph:1774024680081-b41278cd1047f8}} of overnight starter culture.",
