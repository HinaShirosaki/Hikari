  "projects": [
    {
      "id": "1773446973979-1dead4da556a2",
      "name": "PD-1 Nanobody Binder Discovery",
      "description": "Construct and screen a synthetic VHH phage-display library to identify nanobody binders against human PD-1 extracellular domain. Includes biopanning, phage ELISA, clone picking, sequencing, and preliminary affinity ranking."
    },
    {
      "id": "1773446992429-e6a278f5f6ba58",
      "name": "PD-L1 Blocking Clone Validation",
      "description": "Validate previously identified anti–PD-L1 nanobody clones for blocking activity using cell-based binding assays and competition experiments. Compare expression yield, purity, and functional inhibition across top candidates."
    },
    {
      "id": "1773447052004-86c80b7c5d781",
      "name": "CD19 CAR Binder Optimization",
      "description": "Optimize CD19-binding antibody fragments for improved expression, thermal stability, and binding signal. Includes mutagenesis design, small-scale expression, purification, and BLI-based screening."
    },
    {
      "id": "1773447065150-7d5d223c707f8",
      "name": "SUMO Protease Activity Probe Development",
      "description": "Design and test covalent or activity-based probes for SUMO protease labeling. Work includes probe synthesis planning, protein expression, labeling assays, SDS-PAGE analysis, and LC-MS confirmation."
    },
    {
      "id": "1773447076333-5be5812660656",
      "name": "ncAA Incorporation in sfGFP Reporter",
      "description": "Evaluate noncanonical amino acid incorporation efficiency in an sfGFP amber suppression reporter system using engineered tRNA/synthetase pairs. Measure fluorescence rescue, background readthrough, and expression conditions."
    }
  ],
